# ============================================================
# CURO — Environment Variables Template
# Copy this file to .env and fill in your actual values
# ============================================================

# ── Database (Neon PostgreSQL) ─────────────────────────────
# Get your connection string from https://neon.tech
DATABASE_URL="postgresql://user:password@ep-example-123.us-east-2.aws.neon.tech/curo?sslmode=require"

# ── NextAuth v5 / Auth.js ──────────────────────────────────
# Generate a secret: npx auth secret
AUTH_SECRET="generate_a_random_32_char_string_here"
AUTH_TRUST_HOST="true"
AUTH_URL="http://localhost:3000"

# ── GitHub OAuth ───────────────────────────────────────────
# Create at: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID="your_github_client_id"
AUTH_GITHUB_SECRET="your_github_client_secret"

# ── Python ML Microservice ─────────────────────────────────
PYTHON_ML_SERVICE_URL="http://127.0.0.1:8000"